# Токен бота сообщества. Получить в управлении сообществом.
# Не коммитить реальное значение.
VK_BOT_TOKEN=replace_with_community_token

# Ссылка на диалог сообщества для кнопки «Написать менеджеру».
# Допустимы https://vk.com/..., https://vk.me/... и https://vk.ru/...
MANAGER_CONTACT_URL=https://vk.me/replace_with_community

# Необязательные настройки
MANAGER_MODE_TTL_HOURS=12
LOG_LEVEL=INFO
STATE_PATH=runtime/state.json
CATALOG_PATH=catalog/services.json
